{
  "expo": {
    "name": "Cuidado Constante",
    "slug": "cuidado-constante",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cuidado-constante",



    "splash": {
      "backgroundColor": "#FFFFFF"
    },

    "plugins": [
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Precisamos da localização em segundo plano para rastrear seu pet."
        }
      ]
    ],
    "android": {
      "package": "com.cuidadoconstante.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.cuidadoconstante.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Usamos Bluetooth para detectar proximidade da coleira.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Localização em segundo plano para rotas até seu pet.",
        "NSLocationWhenInUseUsageDescription": "Localização para mostrar distância entre você e seu pet."
      }
    },
    "extra": {
      "eas": {
        "projectId": "3d9595ff-1ded-409f-a7a1-49313662fb3d"
      }
    }
  }
}
